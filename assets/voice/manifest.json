  "dialogue": [
    {
      "file": "hero_dlg_01.mp3",
      "text": "……ああ",
      "speakerId": 84,
      "vvFile": "hero_dlg_01.mp3",
      "engine": "gemini:gemini-2.5-flash-preview-tts:Algenib",
      "gm": "hero_gm_01.m4a"
    },
    {
      "file": "hero_dlg_02.mp3",
      "text": "……この字は、あいつか",
      "speakerId": 84,
      "vvFile": "hero_dlg_02.mp3",
      "engine": "gemini:gemini-2.5-flash-preview-tts:Algenib",
      "gm": "hero_gm_02.m4a"
    },
    {
      "file": "hero_dlg_03.mp3",
      "text": "……そうか",
      "speakerId": 84,
      "vvFile": "hero_dlg_03.mp3",
      "engine": "gemini:gemini-2.5-flash-preview-tts:Algenib",
      "gm": "hero_gm_03.m4a"
    },
    {
      "file": "hero_dlg_04.mp3",
      "text": "……その手を離せ",
      "speakerId": 82,
      "vvFile": "hero_dlg_04.mp3",
      "engine": "gemini:gemini-2.5-flash-preview-tts:Algenib",
      "gm": "hero_gm_04.m4a"
    },
    {
      "file": "hero_dlg_05.mp3",
      "text": "……のんべい横丁か",
      "speakerId": 84,
      "vvFile": "hero_dlg_05.mp3",
      "engine": "gemini:gemini-2.5-flash-preview-tts:Algenib",
      "gm": "hero_gm_05.m4a"
    },
    {
      "file": "hero_dlg_06.mp3",
      "text": "……佐伯",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_07.mp3",
      "text": "……帰るか。明日も会社だ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_08.mp3",
      "text": "……渋谷町か。変わっちまったな",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_09.mp3",
      "text": "……道を教えただけだ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_10.mp3",
      "text": "あの店には二度と行くな。行くなら、俺に言え",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_11.mp3",
      "text": "いらん",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_12.mp3",
      "text": "もう一度だけ言う。帰れ",
      "speakerId": 82
    },
    {
      "file": "hero_dlg_13.mp3",
      "text": "スーツが台無しだ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_14.mp3",
      "text": "二十二時。残業を片付けて、帰るだけの夜だった",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_15.mp3",
      "text": "交番の前で、いい度胸だ",
      "speakerId": 82
    },
    {
      "file": "hero_dlg_16.mp3",
      "text": "人違いだ。通してくれ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_17.mp3",
      "text": "十年だ。いい加減、忘れちまえ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_18.mp3",
      "text": "帰り道だ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_19.mp3",
      "text": "店名、住所、代表者名。全部書け",
      "speakerId": 82
    },
    {
      "file": "hero_dlg_20.mp3",
      "text": "急いでる",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_21.mp3",
      "text": "柊。お前は何を始めた",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_22.mp3",
      "text": "残業だ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_23.mp3",
      "text": "線路沿いを北へ歩け。赤い提灯が見えたらそこだ",
      "speakerId": 84
    },
    {
      "file": "hero_dlg_24.mp3",
      "text": "領収書をもらおうか。会社に回す",
      "speakerId": 84
    }
  ]
}